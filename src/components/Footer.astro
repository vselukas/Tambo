---
import { getLang, getUi } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
    email?: string;
    phone?: string;
    instagram?: string;
}

const {
    email = 'tambobook@gmail.com',
    phone = '+420 604 561 690',
    instagram = 'https://www.instagram.com/karolinapistekova/',
} = Astro.props;

const ui = getUi(getLang(Astro.currentLocale));
const t = ui.footer;
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-white/5 bg-mystic-950 py-20 md:py-32 lg:py-48">
    <!-- Background spirit -->
    <div class="pointer-events-none absolute bottom-0 left-1/2 h-[50rem] w-full -translate-x-1/2 rounded-full bg-tambo-lavender/5 blur-[150px]"></div>

    <div class="relative z-10 container mx-auto px-6">
        <div class="mx-auto mb-24 max-w-6xl text-center md:mb-32 lg:mb-48">
            <div data-reveal="scale">
                <Icon name="sparkles" class="mx-auto mb-8 h-8 w-8 animate-pulse text-tambo-lavender md:mb-12 md:h-12 md:w-12" />
                <h2 class="mb-10 font-display text-4xl leading-[1.1] sm:text-5xl md:mb-16 md:text-6xl md:leading-[0.9] lg:text-7xl xl:text-8xl 2xl:text-9xl">
                    {t.title1}<br />
                    <span class="text-spirit font-light italic">{t.title2}</span>
                </h2>
                <a href="#koupit" class="btn-bold w-full sm:w-auto">{t.cta}</a>
            </div>
        </div>

        <div class="grid grid-cols-1 items-start gap-16 border-t border-white/5 pt-16 md:grid-cols-3 md:gap-24 md:pt-24 lg:gap-32 lg:pt-32">
            <div class="space-y-12">
                <h3 class="font-display text-3xl text-tambo-lavender italic">Tambo</h3>
                <p class="border-l border-white/10 pl-8 text-lg leading-relaxed font-light text-white/30 italic">{t.desc}</p>
                <div class="flex gap-6">
                    <a
                        href={instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                        class="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/5 bg-white/[0.02] transition-all duration-700 hover:border-tambo-lavender hover:text-tambo-lavender"
                    >
                        <Icon name="instagram" class="h-6 w-6" />
                    </a>
                </div>
            </div>

            <div class="space-y-12">
                <h4 class="text-[10px] font-black tracking-[0.6em] text-white/40 uppercase">{t.contact}</h4>
                <ul class="space-y-8 text-base font-light text-white/60">
                    <li class="group flex items-center gap-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5 transition-all duration-700 group-hover:bg-tambo-rose/20">
                            <Icon name="mail" class="h-5 w-5 text-tambo-rose" />
                        </div>
                        <a href={`mailto:${email}`} class="text-xs font-bold tracking-widest uppercase transition-colors hover:text-tambo-lavender">{email}</a>
                    </li>
                    <li class="group flex items-center gap-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5 transition-all duration-700 group-hover:bg-tambo-rose/20">
                            <Icon name="phone" class="h-5 w-5 text-tambo-rose" />
                        </div>
                        <a href={`tel:${phone.replace(/\s/g, '')}`} class="text-xs font-bold tracking-widest uppercase transition-colors hover:text-tambo-lavender">{phone}</a>
                    </li>
                </ul>
            </div>

            <div class="space-y-12">
                <h4 class="text-[10px] font-black tracking-[0.6em] text-white/40 uppercase">{t.origin}</h4>
                <div class="space-y-4 text-xs font-bold tracking-[0.3em] text-white/30 uppercase">
                    <p class="text-white">{ui.author.title1} {ui.author.title2}</p>
                    <p>{t.location}</p>
                    <div class="pt-12 text-[10px] font-light tracking-widest lowercase opacity-40">
                        <p>© {year} TAMBO.</p>
                        <p>{t.rights}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
