---
/**
 * Glowing orb that follows the mouse. Desktop only (pointer: fine), hidden
 * until the first mouse move so touch devices never see it.
 */
---

<div id="cursor" class="pointer-events-none fixed inset-0 z-[9999] hidden overflow-hidden" aria-hidden="true">
    <div id="cursor-orb" class="absolute h-8 w-8 -translate-x-1/2 -translate-y-1/2 rounded-full blur-md"></div>
    <div id="cursor-spark" class="absolute h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white shadow-[0_0_10px_#fff]"></div>
</div>

<style>
    #cursor-orb {
        background: rgba(255, 126, 179, 0.3);
        animation: cursorBreath 2s ease-in-out infinite, cursorFade 3s ease-in-out infinite;
        transition: background-color 0.4s;
        --cursor-scale: 1;
    }
    #cursor-spark {
        animation: cursorBreath 2s ease-in-out infinite;
        --cursor-scale: 1;
    }
    #cursor.is-hovering #cursor-orb {
        background: rgba(201, 160, 255, 0.4);
        --cursor-scale: 2;
    }
    #cursor.is-hovering #cursor-spark {
        --cursor-scale: 0.5;
        animation: none;
        transform: translate(-50%, -50%) scale(0.5);
    }
    @keyframes cursorBreath {
        0%, 100% { transform: translate(-50%, -50%) scale(var(--cursor-scale)); }
        50% { transform: translate(-50%, -50%) scale(calc(var(--cursor-scale) * 1.1)); }
    }
    @keyframes cursorFade {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 1; }
    }
</style>

<script>
    const root = document.getElementById('cursor');
    const orb = document.getElementById('cursor-orb');
    const spark = document.getElementById('cursor-spark');
    const finePointer = window.matchMedia('(pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (root && orb && spark && finePointer && !reducedMotion) {
        // Target vs. rendered position – the lerp gives the "spring" feel
        let tx = 0, ty = 0, ox = 0, oy = 0, sx = 0, sy = 0;
        let running = false;

        const frame = () => {
            ox += (tx - ox) * 0.35;
            oy += (ty - oy) * 0.35;
            sx += (tx - sx) * 0.55;
            sy += (ty - sy) * 0.55;
            orb.style.left = `${ox}px`;
            orb.style.top = `${oy}px`;
            spark.style.left = `${sx}px`;
            spark.style.top = `${sy}px`;
            if (Math.abs(tx - ox) > 0.1 || Math.abs(ty - oy) > 0.1) {
                requestAnimationFrame(frame);
            } else {
                running = false;
            }
        };

        window.addEventListener('mousemove', (e) => {
            tx = e.clientX;
            ty = e.clientY;
            root.classList.remove('hidden');
            if (!running) {
                running = true;
                requestAnimationFrame(frame);
            }
        });

        window.addEventListener('mouseover', (e) => {
            const target = e.target as Element | null;
            const interactive = !!target?.closest('a, button, [role="button"], .cursor-pointer');
            root.classList.toggle('is-hovering', interactive);
        });

        document.addEventListener('mouseleave', () => root.classList.add('hidden'));
        document.addEventListener('mouseenter', () => root.classList.remove('hidden'));
    }
</script>
