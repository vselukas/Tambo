---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getLang, getUi } from '../i18n/ui';
import Icon from './Icon.astro';
import womanImg from '../assets/meditation.png';

const lang = getLang(Astro.currentLocale);
const t = getUi(lang).testimonials;

const reviews = (await getCollection('testimonials', ({ data }) => data.lang === lang)).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<section id="recenze" class="relative overflow-hidden bg-mystic-950 py-20 md:py-40 lg:py-64">
    <!-- Parallax background motif -->
    <Image
        src={womanImg}
        alt=""
        width={1600}
        quality={40}
        data-parallax-bg
        class="pointer-events-none absolute top-0 left-0 z-0 w-full scale-125 opacity-[0.04] brightness-150 grayscale will-change-transform"
    />

    <!-- Floating mystical elements -->
    <div class="pointer-events-none absolute inset-0 z-0">
        <Icon name="star" class="absolute h-4 w-4 text-tambo-lavender/20" style="top:20%;left:15%;animation:sparkleFloat 6s ease-in-out infinite" />
        <Icon name="star" class="absolute h-2 w-2 text-tambo-rose/30" style="top:60%;right:10%;animation:sparkleFloat 4s ease-in-out infinite 1s" />
        <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1" class="absolute h-12 w-12 text-tambo-purple/10" style="top:40%;left:5%;animation:geoFloat 10s ease-in-out infinite">
            <circle cx="20" cy="20" r="16"></circle>
            <path d="M20 10V30M10 20H30" opacity="0.3"></path>
        </svg>
        <div class="absolute top-1/4 left-[-10%] h-[40rem] w-[40rem] rounded-full bg-tambo-purple/5 blur-[180px]"></div>
        <div class="absolute right-[-10%] bottom-1/4 h-[40rem] w-[40rem] rounded-full bg-tambo-lavender/5 blur-[150px]"></div>
    </div>

    <div class="relative z-10 container mx-auto px-6">
        <div data-reveal="up" class="mb-16 text-center md:mb-24 lg:mb-40">
            <span class="mb-4 block font-body text-[10px] font-black tracking-[0.6em] text-tambo-rose uppercase opacity-60 md:mb-6 md:text-xs">
                {t.tagline}
            </span>
            <h2 class="mb-6 font-display text-3xl leading-[1.1] text-white sm:text-4xl md:mb-8 md:text-6xl lg:text-7xl">
                {t.title1}<br />
                <span class="text-tambo-lavender italic drop-shadow-[0_0_15px_rgba(201,160,255,0.2)]">{t.title2}</span>
            </h2>
            <div class="mx-auto h-px w-16 bg-linear-to-r from-transparent via-tambo-lavender/30 to-transparent"></div>
        </div>

        <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 md:gap-8 lg:gap-16">
            {reviews.map((review, idx) => (
                <blockquote
                    data-reveal="up"
                    style={`--reveal-delay:${idx * 0.15}s`}
                    class="glass-spirit group relative flex flex-col justify-between p-8 transition-all duration-1000 hover:border-tambo-lavender/30 md:p-10 lg:p-16"
                >
                    <Icon name="quote" class="absolute top-6 left-6 h-8 w-8 text-tambo-rose/5 transition-colors group-hover:text-tambo-rose/10 md:top-8 md:left-8 md:h-12 md:w-12" />
                    <p class="relative z-10 mb-8 text-lg leading-relaxed font-light text-white/50 italic transition-colors group-hover:text-white/80 md:mb-10 md:text-xl lg:text-2xl">
                        "{review.data.quote}"
                    </p>
                    <footer class="flex items-center gap-6">
                        <div class="h-px w-10 bg-tambo-lavender/20 transition-all duration-700 group-hover:w-16"></div>
                        <cite class="font-body text-xs font-bold tracking-[0.3em] text-tambo-lavender/60 uppercase not-italic">{review.data.author}</cite>
                    </footer>
                    <div class="absolute inset-0 rounded-[inherit] bg-linear-to-br from-white/[0.02] to-transparent opacity-0 transition-opacity duration-1000 group-hover:opacity-100"></div>
                </blockquote>
            ))}
        </div>
    </div>
</section>

<script>
    // Slow vertical drift of the background motif while the section scrolls by (−150px … +150px)
    const section = document.getElementById('recenze');
    const bg = section?.querySelector<HTMLElement>('[data-parallax-bg]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (section && bg && !reducedMotion) {
        let ticking = false;
        const update = () => {
            ticking = false;
            const r = section.getBoundingClientRect();
            const vh = window.innerHeight;
            // 0 when the section's top reaches the bottom of the viewport, 1 when its bottom leaves the top
            const progress = Math.min(Math.max((vh - r.top) / (vh + r.height), 0), 1);
            bg.style.transform = `translateY(${-150 + progress * 300}px) scale(1.25)`;
        };
        window.addEventListener('scroll', () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        }, { passive: true });
        update();
    }
</script>
