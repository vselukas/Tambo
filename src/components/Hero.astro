---
import { Image, getImage } from 'astro:assets';
import { getLang, getUi } from '../i18n/ui';
import Icon from './Icon.astro';
import mockup from '../assets/mockup.png';
import universe from '../assets/universe.png';

interface Props {
    /** Link of the secondary button (book sample PDF). */
    sampleUrl?: string;
    /** Anchor of the primary button. */
    ctaHref?: string;
}

const {
    sampleUrl = 'https://cdn.prod.website-files.com/645a912a87cb14233f9f9bbd/6491ab808b79409bef0cf5df_Tambo-Ukazka.pdf',
    ctaHref = '#koupit',
} = Astro.props;

const t = getUi(getLang(Astro.currentLocale)).hero;
// Background portal is blurred to 20px anyway, so a small webp is plenty
const universeBg = await getImage({ src: universe, width: 640, format: 'webp', quality: 60 });

const sparkles = [
    { cls: 'w-3 h-3 text-tambo-lavender/60', style: 'top:15%;left:10%;animation:sparkleFloat 4s ease-in-out infinite' },
    { cls: 'w-2 h-2 text-tambo-rose/50', style: 'top:28%;right:18%;animation:sparkleFloat 5s ease-in-out infinite 1s' },
    { cls: 'w-4 h-4 text-tambo-lavender/40', style: 'top:22%;right:35%;animation:sparkleFloat 6s ease-in-out infinite 0.5s' },
    { cls: 'w-2.5 h-2.5 text-tambo-purple/50', style: 'top:70%;left:8%;animation:sparkleFloat 4.5s ease-in-out infinite 2s' },
    { cls: 'w-2 h-2 text-tambo-rose/40', style: 'bottom:25%;right:12%;animation:sparkleFloat 5.5s ease-in-out infinite 1.5s' },
];
---

<section id="hero" class="relative flex min-h-screen items-center overflow-hidden py-24 md:py-32 lg:py-0">
    <!-- Film grain overlay -->
    <div class="pointer-events-none absolute inset-0 z-50 opacity-[0.03] mix-blend-overlay">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
            <filter id="noiseFilter">
                <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"></feTurbulence>
            </filter>
            <rect width="100%" height="100%" filter="url(#noiseFilter)"></rect>
        </svg>
    </div>

    <!-- Deep background with glow orbs -->
    <div class="absolute inset-0 -z-30 bg-mystic-950/20">
        <div class="absolute top-0 right-0 h-[60vw] w-[60vw] rounded-full bg-tambo-lavender/[0.01] blur-[180px]"></div>
        <div class="absolute top-1/3 left-1/3 h-[80vw] w-[80vw] animate-pulse-spirit rounded-full bg-tambo-purple/[0.02] blur-[200px] md:h-[60vw] md:w-[60vw]"></div>
        <div class="absolute right-1/3 bottom-1/4 h-[70vw] w-[70vw] animate-pulse-spirit rounded-full bg-tambo-rose/[0.01] blur-[220px] md:h-[50vw] md:w-[50vw]" style="animation-delay:-3s"></div>
    </div>

    <!-- Drifting mist -->
    <div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden">
        <div class="absolute -bottom-20 -left-20 h-[40%] w-[120%] animate-mist bg-linear-to-t from-tambo-purple/[0.05] via-transparent to-transparent blur-[120px]"></div>
    </div>

    <!-- Floating sparkles & geometric shapes -->
    <div class="pointer-events-none absolute inset-0 -z-10">
        {sparkles.map((s) => <Icon name="star" class={`absolute ${s.cls}`} style={s.style} />)}

        <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" class="absolute h-6 w-6 text-tambo-rose/25" style="top:18%;left:12%;animation:geoFloat 8s ease-in-out infinite, geoSpin 15s linear infinite"><polygon points="20,4 36,36 4,36"></polygon></svg>
        <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" class="absolute h-5 w-5 text-tambo-lavender/20" style="bottom:30%;right:22%;animation:geoFloat 7s ease-in-out infinite 2s, geoSpin 20s linear infinite reverse"><polygon points="20,4 36,36 4,36"></polygon></svg>
        <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" class="absolute h-5 w-5 text-tambo-purple/20" style="top:65%;right:28%;animation:geoFloat 9s ease-in-out infinite 1s"><circle cx="20" cy="20" r="16"></circle></svg>
        <svg viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1.5" class="absolute h-6 w-6 text-tambo-lavender/20" style="bottom:40%;left:12%;animation:geoFloat 7s ease-in-out infinite 1.5s, geoSpin 18s linear infinite"><rect x="5" y="5" width="20" height="20" transform="rotate(45 15 15)"></rect></svg>
    </div>

    <!-- Main content: book left, text right -->
    <div class="relative z-10 container mx-auto scale-[1.02] px-6 pt-20 lg:px-20 lg:pt-0">
        <div class="flex flex-col items-center gap-8 md:gap-16 lg:flex-row lg:gap-32">
            <!-- Book with masked universe backdrop -->
            <div class="hero-book-in relative mb-8 flex w-64 max-w-full shrink-0 items-center justify-center p-8 md:w-80 md:p-12 lg:mb-0 lg:w-[24rem] xl:w-[28rem] 2xl:w-[32rem]">
                <div data-parallax="book" class="relative flex h-full w-full items-center justify-center will-change-transform">
                    <div data-parallax="portal" class="pointer-events-none absolute inset-0 -z-20 perspective-[1000px] will-change-transform">
                        <div
                            class="absolute inset-[-25%] bg-cover bg-center"
                            style={`background-image:url(${universeBg.src});mask-image:radial-gradient(circle at center, black 20%, rgba(0,0,0,0.8) 45%, transparent 75%);-webkit-mask-image:radial-gradient(circle at center, black 20%, rgba(0,0,0,0.8) 45%, transparent 75%);filter:blur(20px) brightness(1.5);opacity:0.4`}
                        ></div>
                        <div class="absolute inset-[-15%] animate-pulse bg-tambo-lavender/10 mix-blend-screen blur-[140px]" style="animation-duration:6s"></div>
                    </div>

                    <Image
                        src={mockup}
                        alt={t.mockupAlt}
                        widths={[320, 512, 768, 1024]}
                        sizes="(min-width: 1536px) 28rem, (min-width: 1280px) 24rem, (min-width: 1024px) 20rem, (min-width: 768px) 16rem, 12rem"
                        loading="eager"
                        fetchpriority="high"
                        class="relative z-20 w-full drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)] transition-transform duration-700 ease-out hover:scale-105 hover:rotate-1"
                    />
                </div>
            </div>

            <!-- Text -->
            <div data-parallax="text" class="hero-text-in flex-1 text-center lg:max-w-none lg:pt-12 lg:text-left">
                <span class="mb-6 block font-body text-xs font-black tracking-[0.8em] text-tambo-lavender uppercase opacity-90 drop-shadow-[0_0_15px_rgba(201,160,255,0.5)] sm:text-sm md:mb-10">
                    {t.tagline}
                </span>

                <h1 class="mb-8 font-display text-4xl leading-[1.1] text-white sm:text-5xl md:mb-12 md:text-6xl md:leading-[0.9] lg:text-[4rem] xl:text-[5rem] 2xl:text-[6.5rem]">
                    {t.title1}<br />
                    <span class="relative">
                        {t.title2}{' '}
                        <span
                            class="relative inline-block animate-shimmer italic"
                            style="background:linear-gradient(90deg,#C9A0FF,#FF7EB3,#C9A0FF);background-size:200% auto;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 0 25px rgba(255,126,179,0.5))"
                        >
                            {t.title3}
                        </span>
                    </span>
                </h1>

                <p class="mx-auto mb-10 max-w-xl border-l-4 border-tambo-lavender/30 pl-6 text-lg leading-relaxed font-light text-white/40 italic md:mb-14 md:pl-10 md:text-xl lg:mx-0 lg:text-2xl">
                    {t.desc}
                </p>

                <div class="flex w-full flex-col items-center gap-4 sm:w-auto sm:flex-row sm:gap-8 lg:items-start">
                    <a href={ctaHref} class="btn-bold w-full sm:w-auto">{t.ctaPrimary}</a>
                    <a href={sampleUrl} target="_blank" rel="noopener noreferrer" class="btn-outline-spirit w-full text-[11px] sm:w-auto md:text-[13px]">
                        {t.ctaSecondary}
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // Mouse + scroll parallax for the book, its portal backdrop and the text.
    // Values mirror the original framer-motion ranges.
    const hero = document.getElementById('hero');
    const book = hero?.querySelector<HTMLElement>('[data-parallax="book"]');
    const portal = hero?.querySelector<HTMLElement>('[data-parallax="portal"]');
    const text = hero?.querySelector<HTMLElement>('[data-parallax="text"]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;

    if (hero && book && portal && text && !reducedMotion) {
        let tx = 0, ty = 0; // mouse target, −0.5 … 0.5
        let mx = 0, my = 0; // smoothed mouse
        let scroll = 0; // 0 at top, 1 when hero has scrolled out
        let ticking = false;

        const render = () => {
            ticking = false;
            mx += (tx - mx) * 0.08;
            my += (ty - my) * 0.08;
            const glow = 1 + Math.min(scroll * 2, 1) * 0.2;
            book.style.transform = `translate3d(${mx * 40}px, ${my * 40 - scroll * 100}px, 0) scale(${glow})`;
            portal.style.transform = `translate3d(${-mx * 30}px, ${-my * 30 - scroll * 150}px, 0) rotateY(${mx * 10}deg) rotateX(${-my * 10}deg)`;
            text.style.transform = `translateY(${-scroll * 50}px)`;
            if (Math.abs(tx - mx) > 0.001 || Math.abs(ty - my) > 0.001) schedule();
        };
        const schedule = () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(render);
            }
        };

        if (finePointer) {
            window.addEventListener('mousemove', (e) => {
                tx = e.clientX / window.innerWidth - 0.5;
                ty = e.clientY / window.innerHeight - 0.5;
                schedule();
            });
        }
        window.addEventListener(
            'scroll',
            () => {
                const r = hero.getBoundingClientRect();
                scroll = Math.min(Math.max(-r.top / r.height, 0), 1);
                schedule();
            },
            { passive: true },
        );
        schedule();
    }
</script>
