---
import { Image } from 'astro:assets';
import { getLang, getUi } from '../i18n/ui';
import Icon from './Icon.astro';
import padImg from '../assets/art/pad.jpg';
import studImg from '../assets/art/stud.jpg';
import navratImg from '../assets/art/navrat.jpg';

const t = getUi(getLang(Astro.currentLocale)).hook;

// Three illustrated steps: Fall → Shame → Return. Texts come from i18n, art is fixed.
const art = [padImg, studImg, navratImg];
const steps = t.steps.map((step, i) => ({ ...step, image: art[i] }));
---

<section id="o-knize" class="relative overflow-hidden bg-mystic-950 py-20 md:py-32 lg:py-48">
    <!-- Background atmosphere -->
    <div class="pointer-events-none absolute top-0 left-0 h-full w-full opacity-30">
        <div class="absolute top-1/4 -left-1/4 h-[60rem] w-[60rem] animate-pulse-spirit rounded-full bg-tambo-purple/20 blur-[200px]"></div>
        <div class="absolute -right-1/4 bottom-1/4 h-[50rem] w-[50rem] rounded-full bg-tambo-rose/10 blur-[180px]"></div>
    </div>

    <div class="relative z-10 container mx-auto px-6">
        <!-- Header -->
        <div data-reveal="up" class="mb-16 text-center md:mb-24 lg:mb-40">
            <span class="hook-tagline mb-6 block font-body text-xs font-black tracking-[0.6em] text-tambo-rose uppercase opacity-80 sm:tracking-[0.8em] md:mb-8">
                {t.tagline}
            </span>
            <h2 class="hook-title mb-8 font-display text-3xl leading-[1.1] text-white sm:text-4xl md:mb-12 md:text-6xl lg:text-8xl">
                {t.title1}<br />
                <span class="text-tambo-lavender italic drop-shadow-[0_0_15px_rgba(201,160,255,0.3)]">{t.title2}</span>{' '}{t.title3}
            </h2>
            <div class="mx-auto mb-8 h-px w-24 bg-linear-to-r from-transparent via-white/20 to-transparent md:mb-12"></div>
            <p class="hook-desc mx-auto max-w-3xl border-y border-white/5 py-8 text-base leading-relaxed font-light text-white/40 italic sm:text-lg md:py-12 md:text-xl">
                {t.desc}
            </p>
        </div>

        <!-- Immersive grid -->
        <div class="relative grid grid-cols-1 items-center gap-12 md:gap-16 lg:grid-cols-3 lg:gap-20">
            {steps.map((step, idx) => (
                <div class="group relative flex flex-col items-center">
                    <div data-reveal="up" style={`--reveal-delay:${idx * 0.2}s`}>
                        <div class="hook-card glass-spirit relative aspect-[3/4] overflow-hidden rounded-2xl transition-transform duration-700 group-hover:scale-[1.02]">
                            <Image
                                src={step.image}
                                alt={step.title}
                                widths={[480, 720]}
                                sizes="(min-width: 1024px) 30vw, 90vw"
                                class="h-full w-full object-cover opacity-80 transition-transform duration-1000 group-hover:scale-110 group-hover:opacity-100"
                            />
                            <div class="absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-mystic-950 via-mystic-950/40 to-transparent opacity-90"></div>

                            <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 lg:p-10">
                                <h3 class="hook-card-title mb-4 font-display text-2xl text-white drop-shadow-sm md:mb-6 md:text-3xl lg:text-5xl">{step.title}</h3>
                                <p class="hook-card-text font-body text-sm leading-relaxed text-white/80 transition-colors group-hover:text-white sm:text-base lg:text-lg">{step.desc}</p>
                            </div>

                            <div class="absolute inset-0 rounded-2xl border border-white/5 transition-colors duration-700 group-hover:border-tambo-lavender/30"></div>
                        </div>

                        <div class="absolute top-1/2 left-1/2 -z-10 h-full w-full -translate-x-1/2 -translate-y-1/2 bg-tambo-purple/5 opacity-0 blur-[80px] transition-opacity duration-1000 group-hover:opacity-100"></div>
                    </div>

                    {idx < steps.length - 1 && (
                        <div class="pointer-events-none absolute -bottom-10 left-1/2 z-20 flex -translate-x-1/2 justify-center md:-bottom-12 lg:top-1/2 lg:bottom-auto lg:left-[calc(100%+40px)] lg:-translate-y-1/2">
                            <div class="animate-bounce-y text-white opacity-20 lg:opacity-30">
                                <Icon name="arrow-right" strokeWidth={1} class="h-8 w-8 rotate-90 lg:h-10 lg:w-10 lg:rotate-0" />
                            </div>
                        </div>
                    )}
                </div>
            ))}
        </div>
    </div>
</section>
