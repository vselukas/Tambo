---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { getLang, getUi, locales } from '../i18n/ui';
import CustomCursor from '../components/CustomCursor.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import bookCover from '../assets/book-cover.webp';

interface Props {
    /** Overrides the localised default from i18n/*.json */
    title?: string;
    description?: string;
}

const lang = getLang(Astro.currentLocale);
const ui = getUi(lang);
const { title = ui.meta.title, description = ui.meta.description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = getAbsoluteLocaleUrl(lang);
const ogImage = await getImage({ src: bookCover, format: 'jpg', quality: 85 });
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
        <link rel="canonical" href={canonical} />
        {locales.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
        <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('cs')} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_US'} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="theme-color" content="#0f0a18" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
            rel="stylesheet"
        />

        {/* Marks JS as running so CSS can hide reveal targets without breaking no-JS visitors */}
        <script is:inline>document.documentElement.classList.add('js');</script>
    </head>

    <body>
        <div class="min-h-screen overflow-x-hidden bg-mystic-900">
            <CustomCursor />
            <Navbar />
            <main><slot /></main>
            <Footer />
        </div>

        <script>
            // Scroll reveal: adds .is-visible once, when an element enters the viewport
            const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
            if ('IntersectionObserver' in window && targets.length) {
                const io = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                io.unobserve(entry.target);
                            }
                        }
                    },
                    { rootMargin: '0px 0px -10% 0px' },
                );
                targets.forEach((el) => io.observe(el));
            } else {
                targets.forEach((el) => el.classList.add('is-visible'));
            }
        </script>
    </body>
</html>
